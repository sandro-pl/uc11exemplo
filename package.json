{
  "name": "uc11-jest-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Laboratório UC11: testes e implantação com Node, Jest e Git",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node servidor.cjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll",
    "exemplos": "jest --runInBand --config jest.exemplos.config.cjs",
    "cobertura": "jest --runInBand --coverage",
    "implantar": "node scripts/implantar.cjs"
  },
  "devDependencies": {
    "jest": "30.5.0"
  }
}
